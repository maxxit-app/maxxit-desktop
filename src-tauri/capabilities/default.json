{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local Maxxit window capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "autostart:allow-is-enabled",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "updater:default",
    "process:allow-restart",
    "allow-snapshot",
    "allow-export-token-csv",
    "allow-save-settings",
    "allow-claude-preview",
    "allow-connect-provider",
    "allow-disconnect-provider",
    "allow-save-project",
    "allow-remove-project",
    "allow-cloud-start",
    "allow-cloud-redeem",
    "allow-cloud-disconnect",
    "allow-cloud-sync",
    "allow-cloud-action",
    "allow-cloud-preferences",
    "allow-open-link",
    "allow-local-analysis",
    "allow-local-task",
    "allow-local-import",
    "allow-local-remove",
    "allow-local-export",
    "allow-remove-cloud-copies",
    "allow-account-status",
    "allow-cloud-cancel",
    "allow-legacy-preview",
    "allow-legacy-import"
  ]
}
