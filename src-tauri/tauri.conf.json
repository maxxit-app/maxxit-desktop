{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maxxit",
  "version": "0.1.2",
  "identifier": "app.maxxit.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maxxit",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#f7f7f2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI allowance and useful next steps, on your Mac.",
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5MzU1QTRDQUE2QTJBRkUKUldUK0ttcXFURm8xYWJHcG5iVFVuamRGMVdKSXI0ZXlWbmFKd21sY2RyTHZxNTVuSUZGTzlqa2kK",
      "endpoints": [
        "https://github.com/maxxit-app/maxxit-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
